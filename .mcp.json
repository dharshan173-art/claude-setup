{
  "mcpServers": {
    "skillspector": {
      "command": "skillspector",
      "args": [
        "mcp"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp",
        "--no-telemetry"
      ]
    }
  }
}
